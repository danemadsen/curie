<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- "Hey Curie": the prominent disclosure, shown with consent buttons right before the permission prompts.
         %1$s is the default speech recognition service, such as "Speech Recognition and Synthesis from Google",
         always in the middle of a sentence. The _on_device text is for phones whose on-device recognizer
         Curie prefers. -->
    <string name="wake_word_disclosure_title">Turn on “Hey Curie”?</string>
    <string name="wake_word_disclosure">Curie collects microphone audio to enable the “Hey Curie” wake word, even when the app is closed or not in use. The audio is recognised by %1$s, which may send it to its servers to do so. Curie doesn\'t save this audio. While Curie listens, a microphone indicator and a notification stay visible, and the battery drains faster.</string>
    <string name="wake_word_disclosure_on_device">Curie collects microphone audio to enable the “Hey Curie” wake word, even when the app is closed or not in use. The audio is recognised by your phone\'s on-device speech recognition when it supports English, and otherwise by %1$s, which may send it to its servers to do so. Curie doesn\'t save this audio. While Curie listens, a microphone indicator and a notification stay visible, and the battery drains faster.</string>
    <string name="wake_word_speech_service_generic">your phone\'s speech recognition service</string>
    <string name="wake_word_disclosure_accept">Turn on</string>
    <string name="wake_word_disclosure_decline">Not now</string>
    <string name="wake_word_experimental">Experimental on this Android version: listening restarts every few seconds and may beep.</string>

