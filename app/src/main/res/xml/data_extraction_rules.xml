<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Cloud backups (a 25 MB quota, skipped entirely beyond it) keep the chats and
     settings but no media and not the model, which is downloaded again; the data layer shows
     missing media as unavailable. Device transfers carry everything but the model. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="model/" />
        <exclude domain="file" path="attachments/" />
        <exclude domain="file" path="speech/" />
        <exclude domain="file" path="profile/" />
        <exclude domain="sharedpref" path="wake_word_user_stop.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="model/" />
        <exclude domain="sharedpref" path="wake_word_user_stop.xml" />
    </device-transfer>
</data-extraction-rules>
