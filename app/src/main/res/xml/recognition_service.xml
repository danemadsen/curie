<?xml version="1.0" encoding="utf-8"?>
<!--
    The metadata of CurieRecognitionService, which only exists because the voice interaction service
    must name a recognitionService. selectableAsDefault (API 31, the only versions the service is
    enabled on) keeps it from ever becoming the default recognizer.
-->
<recognition-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:selectableAsDefault="false"
    tools:targetApi="s" />
